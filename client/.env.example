# Public site address, no trailing slash. Used for canonical links and the sitemap.
NEXT_PUBLIC_SITE_URL=https://made-your-dream-bigger.vercel.app
# Public API origin used by the Capacitor Android APK and client requests.
NEXT_PUBLIC_API_URL=https://server-s3yn.vercel.app
# Optional: Google Web Client ID for instant Google Sign-In in Web and Android APK.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# API address, read on the server only (never sent to the browser).
API_URL=https://server-s3yn.vercel.app
