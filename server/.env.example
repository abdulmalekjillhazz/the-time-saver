# Copy this file to server/.env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000
# Local MongoDB (for example: docker run -d -p 27017:27017 --name sr-mongo mongo:7)
MONGODB_URI=mongodb://127.0.0.1:27017/smart-routine-dev
CLIENT_ORIGIN=http://localhost:3000
# Optional Web Push holiday/routine reminders. Generate with web-push generate-vapid-keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
SCHEDULER_ENABLED=true
# Required for integration tests. Use a separate database whose name contains "test"; the suite wipes it.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/smart-routine-test
# Admin two-factor secrets are encrypted with this key. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_ENC_KEY=
# Optional: exact owner account that can use admin tools without setting up MFA.
# Keep this to a single trusted email; the account still requires password login and owner role.
# Cloudinary (all three or none). Used for saving generated story/lesson audio & media.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional Gemini API key for midnight daily stories/quizzes and owner-requested lesson drafts. Keep server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional ElevenLabs narration for the daily family story, lessons, and word pronunciation.
# Default voice IDs are pre-configured automatically when ELEVENLABS_API_KEY is set, or you can override them below:
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_FATHER_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MOTHER_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_SON_VOICE_ID=IKne3meq5aSn9XLyUdCD
ELEVENLABS_STORYTELLER_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Keyed-hash secret for training data pseudonyms. At least 32 characters. Never commit. Never change after training starts (it would break linkage).
TRAINING_SECRET=
# Optional: error tracking (Sentry DSN). Leave empty to disable.
SENTRY_DSN=
# Optional: a long random string. Lets your uptime monitor see readiness details via header X-Ready-Token.
READY_TOKEN=

# User-facing AI assistant (routine chat + goal-to-routine generation)
# Gemini is tried first; Groq is used only as a fallback if Gemini is unset or fails.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google Identity Services sign-in (Web + Android APK):
# Put your Web Application Client ID in GOOGLE_CLIENT_ID (you can also comma-separate Web,Android IDs here)
# and/or put your Android OAuth Client ID in GOOGLE_ANDROID_CLIENT_ID.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Optional Telegram habit bot. When set, local-user reminders and daily briefs are enabled.
TELEGRAM_BOT_TOKEN=
